#!/usr/bin/env bash
# pre-push 훅: 스킬별 회귀 스위트(contexts/*/tests/run.sh)를 여기서 실행한다.
#
# 이 스위트는 checkov/tflint/sam 등 무거운 외부 도구를 픽스처에 반복 호출하는데,
# 픽스처 기반이라 "지금 이 커밋의 실제 변경분이 안전한가"가 아니라 "검증 로직
# 자체가 여전히 제대로 도는가"를 확인하는 것이다. 그래서 커밋 1번마다 매번 돌 필요는
# 없고, 코드가 실제로 이 머신을 떠나는 시점(push)에 한 번만 돌아도 보호 수준은
# 그대로다. pre-commit 쪽엔 trufflehog(시크릿 스캔)와 pre-flight-check.sh 본체
# (지금 스테이징된 실제 diff에 대한 캐시 가능한 검증)만 남겨 반복 커밋 루프를 빠르게
# 유지한다.
#
# 사용: git push 시 자동 호출. core.hooksPath(~/.githooks → git/.githooks)로 배포됨.

set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
cd "$REPO_ROOT" || exit 1

# 전역 훅이라 dotfiles 밖의 임의 ~/workspace 저장소에서도 push 시 실행된다. contexts/
# 스킬 구조 자체가 dotfiles 전용이므로 그 밖에서는 조용히 통과한다.
[ "$(basename "$REPO_ROOT")" = "dotfiles" ] || exit 0

# 비대화형 환경에서도 mise 도구(checkov/tflint/sam 등)를 찾을 수 있도록 PATH 주입.
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

# FinOps 회귀 테스트(contexts/pre-flight-check/tests/test-finops.sh)가 infracost
# 무료 티어를 쓰므로, 개발 루프(just test)에서는 건너뛰고 push 시점에만 실제로
# 호출한다 — pre-commit의 RUN_COST_CHECK와 동일한 이유, 별도 프로세스라 여기서도
# 다시 켜야 한다.
export RUN_COST_CHECK=true

EMPTY_TREE=$(git hash-object -t tree /dev/null)
ZERO_SHA="0000000000000000000000000000000000000000"

CHANGED_SKILLS=()
add_skill() {
  local s=$1 existing
  [ -x "$REPO_ROOT/contexts/$s/tests/run.sh" ] || return 0
  for existing in "${CHANGED_SKILLS[@]:-}"; do
    [ "$existing" = "$s" ] && return 0
  done
  CHANGED_SKILLS+=("$s")
}

# add_skills_testing <파일명>
# 그 파일을 참조하는 회귀 테스트를 가진 스킬을 이름으로 역추적해 전부 대상에 넣는다.
#
# bin/ 하위 스크립트는 "어느 스킬이 이걸 테스트하는가"가 경로에 드러나지 않는다. 예전엔
# 전부 dotfiles 스위트로 보냈는데, 실제 회귀 테스트는 스킬별로 흩어져 있다(실측 매핑:
# idempotency-check.sh -> pre-flight-check 한 곳뿐, db-sg-checker.sh -> containers +
# pre-flight-check, k8s-check.sh -> k8s + pre-flight-check, prompt-lint.sh ->
# prompt-architect). 그래서 그 파일들을 고쳐도 정작 그것을 검증하는 스위트는 한 번도 돌지
# 않고 dotfiles 스위트만 초록불로 지나갔다 — test-coverage-check.sh 가 "회귀 테스트가
# 존재하는가"를 하드 게이트로 강제해 놓고, 정작 실행은 다른 곳을 돌리고 있던 셈이다.
#
# 소유 스킬을 파일명 규칙으로 유추(k8s-check.sh -> k8s)하지 않는다. 그 매핑은 스크립트가
# 늘거나 이름 규칙이 바뀌면 조용히 낡는다(같은 이유로 위 코어 케이스도 소비자 목록을
# 나열하지 않는다). 대신 test-coverage-check.sh 가 커버리지를 판정할 때 쓰는 것과 똑같은
# 기준 — "그 이름이 contexts/<skill>/tests 안에서 언급되는가" — 을 그대로 역방향으로 쓴다.
# 두 게이트가 같은 기준을 공유하므로 한쪽만 낡는 드리프트가 생기지 않는다.
#
# 어느 스위트도 참조하지 않으면 종전대로 dotfiles 로 보낸다(신규 스크립트 등). 그 상태
# 자체는 test-coverage-check.sh 가 별도로 차단한다.
add_skills_testing() {
  local name=$1 tdir found=0
  for tdir in "$REPO_ROOT"/contexts/*/tests; do
    [ -d "$tdir" ] || continue
    grep -qrF --binary-files=without-match -- "$name" "$tdir" 2>/dev/null || continue
    add_skill "$(basename "$(dirname "$tdir")")"
    found=1
  done
  [ "$found" -eq 1 ] || add_skill dotfiles
}

collect_changed_skills_from_range() {
  local base=$1 tip=$2 FILE SKILL
  while IFS= read -r FILE; do
    [ -n "$FILE" ] || continue
    case "$FILE" in
    contexts/*/scripts/* | contexts/*/tests/* | contexts/*/examples/*)
      # examples/ 도 스킬 회귀 스위트의 검증 대상이다(contexts/aiops/tests/run.sh 가
      # examples/anomaly-rag-pipeline.py 의 마스킹 로직을 직접 돌린다). 예전엔 이 패턴이
      # 빠져 있어, 그 파일의 PII 마스킹 결함을 고쳐도 push 시 aiops 스위트가 돌지 않았다.
      SKILL=${FILE#contexts/}
      add_skill "${SKILL%%/*}"
      ;;
    bootstrap.sh | ansible/site.yml | bin/utils/merge-agent-hooks.sh)
      # bootstrap.sh 와 ansible 관련 셋업 변경 시 dotfiles 스킬 검증 묶어서 실행
      # (예전엔 여기에 contexts/base.hooks.json 도 있었는데 그 파일은 이 저장소에 실재하지
      #  않는다 — 훅 병합 대상은 merge-agent-hooks.sh 가 직접 조립하므로 죽은 패턴이었다.)
      add_skill dotfiles
      ;;
    bin/lib/* | bin/hooks/pre-flight-check.sh | contexts/.shared/test-lib/*)
      # 모든 스킬의 회귀 스위트가 이 공용 검증 파이프라인 또는 공유 테스트 라이브러리를
      # 거쳐 도는데, 위 케이스는 경로 패턴이 "어떤 스킬 하나"에만 매핑되어 있어 스킬
      # 전용 경로가 아닌 코어 로직·공유 라이브러리 변경은 아무 패턴에도 안 걸린다.
      # 소비자 목록을 나열하면 소비자가 늘어날 때 조용히 낡으므로, 코어 변경과 동일하게
      # contexts/*/tests/run.sh 가 있는 스킬 전부를 대상으로 삼아 이 드리프트를 없앤다.
      for CORE_SKILL_DIR in "$REPO_ROOT"/contexts/*/tests; do
        [ -d "$CORE_SKILL_DIR" ] || continue
        add_skill "$(basename "$(dirname "$CORE_SKILL_DIR")")"
      done
      ;;
    bin/*)
      # 위 코어 패턴에 안 걸리는 나머지 검사 스크립트(bin/linters/*, bin/utils/*,
      # bin/hooks/plugins/*, bin/hooks/run-suite.sh 등). 예전엔 여기서도 dotfiles 스위트
      # 하나로 보냈는데, 이 파일들의 회귀 테스트는 dotfiles 에만 있는 게 아니라 스킬별로
      # 흩어져 있다. 그래서 "커버리지는 강제하면서 정작 그 커버리지를 실행하지는 않는"
      # 상태가 남아 있었다(실측: bin/hooks/plugins/k8s-check.sh 를 고치고 push 하면
      # "건드린 스킬: dotfiles" 한 줄만 뜨고, 그 플러그인을 실제로 검증하는 k8s 스위트의
      # 서브테스트 12건은 한 번도 돌지 않았다). 이름으로 소유 스위트를 역추적한다.
      add_skills_testing "${FILE##*/}"
      ;;
    stow/* | ansible/* | .github/scripts/*)
      # git 훅 본체, ansible 롤, CI 게이트 스크립트. 이쪽은 전용 회귀 테스트가 전부
      # contexts/dotfiles/tests/ 에 모여 있어(test-pre-commit-hook.sh, test-ansible.sh,
      # test-lint-commit-messages.sh 등) 경로만으로 소유 스위트가 확정된다.
      # 파일명 역추적을 쓰지 않는 이유는 basename 이 변별력을 잃기 때문이다 —
      # ansible/roles/*/tasks/main.yml 은 전부 "main.yml", git 훅은 "pre-commit" 처럼
      # 테스트 본문에 산문으로도 흔히 등장하는 낱말이라 무관한 스위트까지 딸려온다.
      #
      # stow/ 는 예전에 stow/git/.githooks/* 로만 좁혀져 있었다. 그러면 같은 디렉토리의
      # stow/zsh/.zshrc(test-zshrc-activation.sh 가 검증)와 stow 패키지 배치 자체
      # (test-stow-backup.sh)가 트리거 밖으로 빠진다. .github/scripts/* 도 마찬가지로
      # test-lint-commit-messages.sh / test-verify-bootstrap-env.sh 라는 전용 스위트가
      # 있는데 패턴이 없어 한 번도 돌지 않았다 — 정작 그 디렉토리는 ci.yml 이 "우회
      # 불가능한 최종 게이트"라고 선언한 곳이라, 커버리지 사각지대의 대가가 가장 크다.
      # (이 패턴은 위 코어 케이스보다 뒤에 와야 한다. case 는 첫 매치만 취하므로
      #  bin/lib/* 같은 코어 변경이 여기로 흡수되면 전 스킬 대상이 dotfiles 하나로 좁아진다.)
      add_skill dotfiles
      ;;
    esac
  done < <(git diff --name-only "$base" "$tip" 2>/dev/null)
}

# git이 stdin으로 "<로컬 ref> <로컬 sha> <원격 ref> <원격 sha>" 줄을 ref당 하나씩 준다.
# local_ref/remote_ref는 프로토콜상 위치를 맞추려고 읽을 뿐 이 훅에서는 안 쓴다.
# shellcheck disable=SC2034
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO_SHA" ] && continue # 브랜치 삭제 push는 대상 없음

  if [ "$remote_sha" = "$ZERO_SHA" ]; then
    # 원격에 없던 새 브랜치 — 비교 기준이 없으니 빈 트리 대비로 HEAD 시점 전체를 본다.
    collect_changed_skills_from_range "$EMPTY_TREE" "$local_sha"
  else
    collect_changed_skills_from_range "$remote_sha" "$local_sha"
  fi
done

if [ "${#CHANGED_SKILLS[@]}" -eq 0 ]; then
  exit 0
fi

RUN_SUITE="$REPO_ROOT/bin/hooks/run-suite.sh"

SKILL_SUITES=()
for SKILL in "${CHANGED_SKILLS[@]}"; do
  SKILL_SUITES+=("$REPO_ROOT/contexts/$SKILL/tests/run.sh")
done

echo "🧪 push 되는 커밋이 건드린 스킬의 회귀 테스트를 실행합니다: ${CHANGED_SKILLS[*]}"

if [ -x "$RUN_SUITE" ]; then
  # 스킬을 하나씩 따로 넘기면 매번 SCRIPTS 배열이 1개뿐이라 run-suite.sh의 배치 병렬
  # 실행이 발동하지 않는다. 바뀐 스킬 전부를 한 번의 호출에 같이 넘겨야 여러 스킬이
  # 동시에 돈다.
  if ! "$RUN_SUITE" "${SKILL_SUITES[@]}"; then
    echo "❌ 회귀 테스트 실패로 push가 차단되었습니다. 위 실패 목록의 스킬을 각각"
    echo "   bash $REPO_ROOT/contexts/<스킬>/tests/run.sh 로 재현하십시오."
    exit 1
  fi
else
  # run-suite.sh 없이도 안전하게 스킬별 순차 실행으로 폴백한다. 이 훅은 위에서 이미
  # dotfiles 저장소로 한정했고 run-suite.sh는 이 저장소에 항상 존재하므로 정상 경로에서는
  # 발생하지 않지만, 배치 인자를 "bash"에 그대로 넘기면 첫 스킬만 스크립트로 실행되고
  # 나머지는 그 스크립트의 인자로 흡수돼 조용히 검증되지 않는 위험을 막기 위해 분기한다.
  for SKILL in "${CHANGED_SKILLS[@]}"; do
    if ! bash "$REPO_ROOT/contexts/$SKILL/tests/run.sh"; then
      echo "❌ $SKILL 회귀 테스트 실패로 push가 차단되었습니다."
      echo "   재현: bash $REPO_ROOT/contexts/$SKILL/tests/run.sh"
      exit 1
    fi
  done
fi

exit 0
