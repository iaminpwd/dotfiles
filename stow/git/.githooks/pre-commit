#!/usr/bin/env bash
# 020-shell-scripting-standard.md의 Hard Block 조건에 따라 strict mode 선언.
# 검증 게이트는 모두 `|| { ...; exit 1; }`로 안전하게 처리됨.
set -euo pipefail

# bash 4.4 이상이 필요함 (mapfile -d 옵션 사용).
# 구버전 bash 환경 방어 및 macOS 기본 bash(3.2) 실행 방지용 버전 체크.
# bootstrap.sh 와 동일하게 brew bash 로 재실행을 시도함.
BASH_VERSION_NUM=$((${BASH_VERSINFO[0]:-0} * 100 + ${BASH_VERSINFO[1]:-0}))
if [ "$BASH_VERSION_NUM" -lt 404 ]; then
  for BASH_CANDIDATE in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    # 버전 산술은 후보 bash 안에서 평가되어야 하므로 홑따옴표가 맞다.
    # shellcheck disable=SC2016
    if [ -x "$BASH_CANDIDATE" ] &&
      [ "$("$BASH_CANDIDATE" -c 'echo $((BASH_VERSINFO[0] * 100 + BASH_VERSINFO[1]))' 2>/dev/null || echo 0)" -ge 404 ]; then
      # ${1+"$@"} 를 쓰는 이유: bash 4.4 미만은 set -u 아래에서 인자가 0개일 때 "$@" 를
      # unbound variable 로 취급해 죽는다. 이 분기가 도는 곳이 정확히 그 bash 다.
      exec "$BASH_CANDIDATE" "$0" ${1+"$@"}
    fi
  done
  echo "❌ 커밋 훅 실행에 bash 4.4 이상이 필요합니다 (현재 ${BASH_VERSION:-알 수 없음})." >&2
  echo "   macOS 기본 bash 는 3.2 입니다. 'brew install bash' 후 다시 시도하십시오." >&2
  exit 1
fi

# git 훅은 저장소 루트를 기준으로 실행되도록 cwd 고정 (하위 디렉토리 실행 시 파일 오판 방지).
cd "$(git rev-parse --show-toplevel)" || exit 1

# 비대화형(Git GUI, CI/CD 등) 커밋 환경에서도 mise 도구(trufflehog 등)를 찾을 수 있도록 PATH 주입
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

# 새로 추가되거나 수정된 파일 목록 추출 (공백/특수문자 포함 파일명 안전 처리를 위해 NUL 구분 배열 사용)
STAGED_FILES=()
mapfile -d '' -t STAGED_FILES < <(git diff --cached --name-only -z --diff-filter=ACM)

if [ "${#STAGED_FILES[@]}" -gt 0 ]; then
  # [보안 패치] 디스크 삭제 후 스테이징 메모리 잔류 취약점 방어.
  # 파일을 디스크에서만 지우고 'git rm --cached'를 안 한 경우 시크릿 스캔이 누락될 수 있음.
  for FILE in "${STAGED_FILES[@]}"; do
    # 서브모듈 및 정상 심볼릭 링크 오탐 방지용 검사
    if [ ! -e "$FILE" ] && [ ! -L "$FILE" ]; then
      echo "❌ 보안 에러: '$FILE' 파일이 디스크에 존재하지 않지만 Git 스테이징 대기열에는 남아있습니다."
      echo "   (만약 시크릿 유출을 피하려고 디스크에서 파일을 지우셨다면,"
      echo "    반드시 'git rm --cached $FILE' 명령어로 Git 캐시에서도 완전히 지워야 합니다!)"
      exit 1
    fi
  done
fi

# 임시 파일 및 자원 정리용 전역 EXIT trap 헬퍼
TMP_HOG=""
TMP_STAGED=""
cleanup() {
  [ -n "$TMP_HOG" ] && rm -f "$TMP_HOG" 2>/dev/null
  [ -n "$TMP_STAGED" ] && rm -rf "$TMP_STAGED" 2>/dev/null
  true
}
trap cleanup EXIT

# 스캔 대상은 워킹트리의 현재 파일이 아니라 "인덱스에 스테이징된 내용"이어야 한다.
# 경로만 넘기면 스캐너가 디스크의 현재 내용을 읽으므로, git add 뒤 워킹트리에서만
# 시크릿을 지우면(파일을 지운 게 아니라 내용만 고친 경우) 스캔은 통과하는데 커밋에는
# 그 시크릿이 그대로 들어간다 — 위 "디스크 삭제 후 스테이징 잔류" 가드는 삭제만 막고
# 이 수정 케이스는 못 막는다(실측 재현: 인덱스에 AWS 키가 남아 있는데 워킹트리가
# 깨끗해 verified/unverified 0건으로 통과). 인덱스 내용을 임시 디렉토리에 그대로 풀어
# 그쪽을 스캔해, 스캔한 바이트와 커밋될 바이트를 일치시킨다.
materialize_staged_content() {
  local dest=$1 file
  for file in "${STAGED_FILES[@]}"; do
    [ -n "$file" ] || continue
    mkdir -p "$dest/$(dirname "$file")"
    # 서브모듈(gitlink)은 blob 이 아니라 커밋 오브젝트라 추출 대상이 아니다. 추출에
    # 실패하면 0바이트 파일이 남아 스캔 노이즈가 되므로 그 자리를 치운다.
    git show ":$file" >"$dest/$file" 2>/dev/null || rm -f "$dest/$file"
  done
}

# mise 환경이 구성되지 않은 외부 저장소에서의 오탐 차단을 위해 실제 실행 가능 여부(--version) 점검.
if command -v trufflehog &>/dev/null && trufflehog --version &>/dev/null; then
  if [ "${#STAGED_FILES[@]}" -gt 0 ]; then
    TMP_HOG=$(mktemp)
    TMP_STAGED=$(mktemp -d)
    materialize_staged_content "$TMP_STAGED"
    # 전체가 아닌 변경된 파일만 스캔 (엄청 빠름)
    if ! trufflehog filesystem "$TMP_STAGED" --no-update --fail >"$TMP_HOG" 2>&1; then
      echo "🔒 커밋 전 시크릿 스캔 결과 (trufflehog):"
      # 스캔 경로가 임시 디렉토리라 그대로 보여주면 어느 파일인지 알아볼 수 없다.
      # 접두사만 걷어내 저장소 상대 경로로 되돌린다.
      sed "s#$TMP_STAGED/##g" "$TMP_HOG"
      echo "❌ 시크릿 유출이 발견되어 커밋이 차단되었습니다."
      exit 1
    fi
    echo "  -> [✓] trufflehog secret scan passed (스테이징된 내용 기준)"
  fi
else
  echo "⚠️ trufflehog를 찾을 수 없거나 현재 위치에서 실행할 수 없어 시크릿 스캔을 건너뜁니다."
fi

# 커밋 시점에만 인프라 및 코드 사전 검증(pre-flight-check)을 수행 (CWD 무관하게 상위 저장소 루트 기반 탐색)
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

# 이 훅 자체가 실제 git 커밋 시점에만 실행되므로, "지금이 진짜 커밋인가"의 신호로
# 그대로 쓴다. `just test` 같은 일반 개발 루프에서는 이 변수가 꺼져 있어 infracost
# 무료 티어 API 호출을 아낀다. 아래 PFC_TARGET(pre-flight-check.sh 본체, 지금
# 스테이징된 실제 diff 검증)이 이 신호로 FinOps 비용 검증까지 수행한다. 스킬 회귀
# 스위트(픽스처 기반 FinOps 테스트 포함)는 pre-push로 옮겼고, 거기서도 이 변수를
# 동일한 이유로 별도로 켠다.
export RUN_COST_CHECK=true

# AI 토큰 최적화를 위해 run-suite.sh가 존재하면 래퍼로 사용한다.
RUN_SUITE="$REPO_ROOT/bin/hooks/run-suite.sh"
if [ ! -x "$RUN_SUITE" ]; then
  RUN_SUITE="bash"
fi

# 스킬별 회귀 스위트(contexts/*/tests/run.sh, checkov/tflint/sam 등 무거운 외부 도구를
# 반복 호출)는 매 커밋마다 돌지 않고 git/.githooks/pre-push 로 옮겨져 있다. 픽스처
# 기반이라 "지금 이 커밋의 실제 변경분이 안전한가"가 아니라 "검증 로직 자체가 여전히
# 제대로 도는가"를 확인하는 것이라, 코드가 실제로 이 머신을 떠나기 직전(push)에 한 번만
# 돌아도 보호 수준은 그대로다. 반복 커밋 시 매번 무조건 다시 도는 비용만 사라진다.

# bin/ 하위(핵심 검증 파이프라인 소스)는 contexts/* 경로 패턴에 안 걸려 pre-push의
# 스킬 회귀 스위트 트리거 대상도 아니다. 그렇다고 여기서 하드 블록하면 로컬마다 다른
# 도구 설치 상태(yq/promtool/infracost 등) 때문에 무관한 변경까지 막히는 일이 생긴다
# — 그건 CI가 할 일이지 로컬 훅이 할 일이 아니다. 대신 어떤 회귀 스위트를 수동으로
# 돌려봐야 하는지만 비차단으로 안내한다.
#
# 이 훅은 전역 core.hooksPath라 dotfiles 밖의 임의 ~/workspace 저장소에서도 실행된다.
# bin/linters/*.sh 같은 경로는 dotfiles 자신의 구조라, 저장소 판별 없이 매칭하면
# 외부 저장소에 우연히 같은 상대경로(예: bin/hooks/foo.sh)가 있을 때 존재하지도 않는
# dotfiles 테스트 경로를 안내하는 오탐이 난다. dotfiles 저장소 안에서 커밋할 때만 켠다.
if [ "$(basename "$REPO_ROOT")" = "dotfiles" ]; then
  BIN_REMINDERS=()
  for FILE in "${STAGED_FILES[@]:-}"; do
    # 각 항목은 "contexts/" 기준 상대경로(스킬/tests/파일명)로 저장한다. test-run-suite.sh와
    # test-tool-probe-ssot.sh는 pre-flight-check가 아니라 dotfiles 스킬 소속이라, 예전처럼
    # 파일명만 저장하고 출력부에서 pre-flight-check/tests/를 일괄로 붙이면 존재하지 않는
    # 경로를 안내하는 오탐이 난다(실제 재현됨: 두 파일 다 "No such file or directory").
    case "$FILE" in
    bin/linters/db-sg-checker.sh)
      BIN_REMINDERS+=("pre-flight-check/tests/test-db-sg.sh")
      ;;
    bin/linters/idempotency-check.sh)
      BIN_REMINDERS+=("pre-flight-check/tests/test-idempotency.sh")
      ;;
    bin/hooks/run-suite.sh)
      BIN_REMINDERS+=("dotfiles/tests/test-run-suite.sh")
      ;;
    bin/lib/tool-probe.sh | bin/hooks/plugins/*.sh)
      BIN_REMINDERS+=("dotfiles/tests/test-tool-probe-ssot.sh" "pre-flight-check/tests/test-plugin-loop.sh")
      ;;
    bin/hooks/pre-flight-check.sh)
      BIN_REMINDERS+=("pre-flight-check/tests/run.sh  # 전체 — pre-flight-check.sh 는 범용 로직이라 파급 범위가 넓음")
      ;;
    bin/linters/*.sh | bin/hooks/*.sh | bin/lib/*.sh)
      BIN_REMINDERS+=("pre-flight-check/tests/run.sh  # 전체 — 아직 전용 서브스위트가 없는 스크립트")
      ;;
    esac
  done
  if [ "${#BIN_REMINDERS[@]}" -gt 0 ]; then
    echo "ℹ️  bin/ 핵심 검증 로직 변경이 감지되었습니다. 아래 서브스위트를 수동으로 확인하는 것을 권장합니다(비차단):"
    # printf에 REPO_ROOT + 리마인더 배열을 한 포맷 문자열의 두 %s로 같이 넘기면, 인자가
    # 포맷보다 많을 때 printf가 포맷을 재순환시켜 REPO_ROOT 자리에 리마인더 값이 밀려
    # 들어간다. 리마인더 이름을 먼저 중복 제거한 뒤 REPO_ROOT는 매 줄 루프 안에서
    # 고정값으로만 쓴다.
    # run.sh (전체) 항목은 설명을 " # ..." 셸 주석으로 붙여, 출력되는 줄을 그대로
    # 복붙해도 유효한 명령으로 실행되게 한다(주석 뒤 텍스트는 셸이 무시).
    while IFS= read -r reminder; do
      echo "    bash $REPO_ROOT/contexts/$reminder"
    done < <(printf '%s\n' "${BIN_REMINDERS[@]}" | sort -u)
  fi
fi

# contexts/ 하위 룰북(.md) 변경 시 프롬프트 린트를 실행하여 참조 파손 방지.
PROMPT_LINT="$REPO_ROOT/bin/linters/prompt-lint.sh"
if [ -f "$PROMPT_LINT" ]; then
  for FILE in "${STAGED_FILES[@]:-}"; do
    case "$FILE" in
    contexts/*.md)
      echo "📝 룰북(.md) 변경이 감지되어 프롬프트 코퍼스 린트를 실행합니다..."
      if ! "$RUN_SUITE" "$PROMPT_LINT"; then
        echo "❌ 프롬프트 코퍼스 린트 실패로 커밋이 차단되었습니다."
        echo "   재현: bash $PROMPT_LINT"
        exit 1
      fi
      break
      ;;
    esac
  done
fi

