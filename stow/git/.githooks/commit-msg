#!/usr/bin/env bash
# commit-msg 훅: 시맨틱 커밋 컨벤션 강제 (전역 훅)
set -euo pipefail

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="${2:-}"

# $2(COMMIT_SOURCE)는 git 이 넘겨주지 않는다. commit-msg 훅이 git 에게서 받는 인자는
# 메시지 파일 경로($1) 하나뿐이고, source 를 $2 로 받는 것은 prepare-commit-msg 훅이다.
# 그래서 이 값은 이 훅을 직접 호출하는 .github/scripts/lint-commit-messages.sh(CI 재검증)
# 에서만 채워지고, 정작 git 이 부르는 실제 커밋 경로에서는 항상 비어 있었다 — 즉 아래
# 머지 면제가 로컬에서 한 번도 동작한 적이 없어 `git merge --no-ff` 가 자동 생성 메시지
# ("Merge branch 'x'")로 인해 "컨벤션 위반"으로 차단됐다(실측 재현). 이 훅은 전역
# core.hooksPath 라 dotfiles 밖 모든 저장소의 머지가 같이 막힌다.
#
# git 경로에서는 진행 중인 작업의 상태 파일로 직접 판정한다. 메시지 문자열("Merge "로
# 시작하는가)이 아니라 상태 파일을 보는 이유는, 사용자가 손으로 쓴 메시지가 우연히 같은
# 낱말로 시작해도 면제되지 않게 하기 위함이다. --git-path 는 worktree/서브모듈에서도
# 올바른 위치를 돌려준다(git 2.5+).
if [ -z "$COMMIT_SOURCE" ]; then
  if [ -f "$(git rev-parse --git-path MERGE_HEAD 2>/dev/null)" ]; then
    COMMIT_SOURCE="merge"
  elif [ -f "$(git rev-parse --git-path SQUASH_MSG 2>/dev/null)" ]; then
    COMMIT_SOURCE="squash"
  fi
fi

# 병합/스쿼시 커밋은 Git이 메시지를 자동 생성하므로 컨벤션 강제 대상에서 제외한다.
if [ "$COMMIT_SOURCE" = "merge" ] || [ "$COMMIT_SOURCE" = "squash" ]; then
  exit 0
fi

# 첫 실제 제목 줄 추출 (주석/빈 줄 제외)
# 개행 없는 마지막 줄 누락 방지를 위해 `|| [ -n "$line" ]` 추가
SUBJECT=""
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
  '#'* | '') continue ;;
  *)
    SUBJECT="$line"
    break
    ;;
  esac
done <"$COMMIT_MSG_FILE"

# 제목 줄이 비어있으면(빈 커밋 메시지) git 자체의 기본 검증에 맡기고 이 훅은 통과시킨다.
if [ -z "$SUBJECT" ]; then
  exit 0
fi

# git rebase --autosquash 대상(fixup!/squash!)과 git revert가 자동 생성하는 메시지는 그대로 통과시킨다.
case "$SUBJECT" in
fixup\!* | squash\!* | Revert\ \"*)
  exit 0
  ;;
esac

# Conventional Commits: type(scope)?!: subject
CONVENTIONAL_PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9._/,-]+\))?!?: .+'

if ! [[ "$SUBJECT" =~ $CONVENTIONAL_PATTERN ]]; then
  # 선행 공백은 따로 짚어 준다. git 은 제목 줄 앞의 공백을 제거하지 않으므로
  # `git commit -m "  feat: 제목"` 이 그대로 이 훅까지 오는데, 그때 아래 "현재 메시지"에는
  # 눈에 보이지 않는 공백만 다를 뿐 완벽히 정상인 제목이 찍힌다 — 사용자는 형식이 맞는데
  # 왜 막히는지 알 방법이 없다(실측 재현). 원인을 이름으로 불러 준다.
  if [[ "$SUBJECT" =~ ^[[:space:]] ]]; then
    echo "❌ 시맨틱 커밋 컨벤션 위반: 제목 줄이 공백으로 시작합니다." >&2
    echo "   앞의 공백을 지우고 'type(scope): subject' 형식으로 다시 작성하십시오." >&2
    echo "   현재 메시지(공백 표시): [$SUBJECT]" >&2
    exit 1
  fi
  echo "❌ 시맨틱 커밋 컨벤션 위반: 커밋 메시지가 'type(scope): subject' 형식이 아닙니다." >&2
  echo "   허용 타입: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert" >&2
  echo "   예: feat(aws): EKS 노드그룹 오토스케일링 정책 추가" >&2
  echo "   현재 메시지: $SUBJECT" >&2
  exit 1
fi

# Atomic Commit Analyzer
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
# 정본 탐색은 3계층으로 둔다: 현재 저장소 -> 이 훅의 물리적 위치 -> $HOME/dotfiles.
#
# 2순위가 없으면 dotfiles 클론이 ~/dotfiles 가 아닐 때(CI 체크아웃 경로, 여러 벌 클론,
# ~/src/dotfiles 같은 개인 배치) 아래 블록이 통째로 조용히 생략된다 — Atomic Commit 분석이
# 사라지는데 아무 표시도 나지 않는다(bin/hooks/pre-flight-*-hook.sh 에서 실측된 것과 같은
# 클래스의 결함).
# 3순위를 남기는 이유: 이 훅은 core.hooksPath 로 전역 배포되는데, 심볼릭 링크가 아니라
# 복사본으로 배치한 환경에서는 2순위가 저장소 밖을 가리킨다. 그 경우 기존 동작을 그대로
# 보존해 어떤 배포 형태에서도 지금보다 나빠지지 않게 한다.
CM_HOOK_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
CM_DOTFILES_ROOT=$(cd "$CM_HOOK_DIR/../../.." 2>/dev/null && pwd || echo "")

LINT_SCRIPT="$REPO_ROOT/bin/linters/semantic-commit-lint.sh"

if [ ! -f "$LINT_SCRIPT" ] && [ -n "$CM_DOTFILES_ROOT" ]; then
  LINT_SCRIPT="$CM_DOTFILES_ROOT/bin/linters/semantic-commit-lint.sh"
fi
if [ ! -f "$LINT_SCRIPT" ]; then
  LINT_SCRIPT="$HOME/dotfiles/bin/linters/semantic-commit-lint.sh"
fi

if [ -f "$LINT_SCRIPT" ]; then
  # macOS/구형 bash 호환성: mapfile 대신 호환성 높은 read 루프 사용 (bash 재실행 가드 불필요)
  STAGED_FILES=()
  while IFS= read -r -d '' STAGED_FILE; do
    STAGED_FILES+=("$STAGED_FILE")
    # --no-renames 를 쓰는 이유는 git/.githooks/pre-commit 의 같은 수집부 주석 참조
    # (rename 이 --diff-filter=ACM 에서 빠져 목록이 비면 Atomic Commit 분석 대상도 사라진다).
  done < <(git diff --cached --name-only -z --no-renames --diff-filter=ACM 2>/dev/null)

  if [ ${#STAGED_FILES[@]} -gt 0 ]; then
    bash "$LINT_SCRIPT" "${STAGED_FILES[@]}" || true
  fi
fi

exit 0
