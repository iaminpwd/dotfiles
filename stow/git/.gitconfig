# ⚠️ 주의: 이 파일은 Git 추적 대상입니다. 개인정보/토큰은 ~/.gitconfig.local 에 저장하십시오.
[include]
    # 개인정보 로컬 파일 분리
    path = ~/.gitconfig.local

[core]
    editor = vim
    autocrlf = input
    # MacOS/Linux: input, Windows: true
    excludesfile = ~/.gitignore_global
	hooksPath = ~/.githooks

[color]
    ui = auto

# GitHub CLI(gh)의 브라우저 로그인 인증을 credential helper로 사용 (bootstrap.sh가 gh 설치 및 인증을 보장).
# 호스트를 한정한다: [credential] 아래 전역으로 두면 GitLab 등 gh와 무관한 호스트에서도
# 매 인증마다 gh 프로세스가 뜬다(gh가 모르는 호스트엔 빈 응답을 내므로 동작은 하지만 순수 낭비).
# 아래 두 항목은 `gh auth setup-git`이 생성하는 표준 형태와 동일하다.
[credential "https://github.com"]
    helper = !gh auth git-credential
[credential "https://gist.github.com"]
    helper = !gh auth git-credential

[alias]
    # 단축어 모음
    st = status
    co = checkout
    cb = checkout -b
    br = branch
    ci = commit
    cm = commit -m
    df = diff
    amend = commit --amend --no-edit
    # 히스토리 그래프
    lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

[push]
    default = simple

[pull]
    rebase = true # Pull 시 불필요한 Merge 커밋 방지

[init]
    defaultBranch = main
