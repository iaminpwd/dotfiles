# ⚠️ 주의: 이 파일은 Git 추적 대상입니다. 개인정보/토큰은 ~/.gitconfig.local 에 저장하십시오.
[include]
    # 개인정보 로컬 파일 분리
    path = ~/.gitconfig.local

[core]
    editor = vim
    autocrlf = input
    # MacOS/Linux: input, Windows: true
    excludesfile = ~/.gitignore_global
	hooksPath = ~/.githooks

[color]
    ui = auto

[credential]
    # 인증 토큰 12시간 메모리 캐싱 (디스크 저장 금지)
    helper = cache --timeout=43200

[alias]
    # 단축어 모음
    st = status
    co = checkout
    cb = checkout -b
    br = branch
    ci = commit
    cm = commit -m
    df = diff
    amend = commit --amend --no-edit
    # 히스토리 그래프
    lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

[push]
    default = simple

[pull]
    rebase = true # Pull 시 불필요한 Merge 커밋 방지

[init]
    defaultBranch = main
