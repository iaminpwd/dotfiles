#!/bin/bash
# 020-shell-scripting-standard.md의 Hard Block 조건(strict mode 미선언 금지)에 따라 선언한다.
# 형제 훅인 commit-msg는 이미 선언되어 있었고 이 파일만 누락되어 있었다(2026-07-27 확인).
# 아래 검증 게이트는 전부 `|| { ...; exit 1; }`로 명시 처리하므로 set -e가 기존 차단/통과
# 판정을 바꾸지 않는다(빈 스테이징/텍스트/yaml/쉘 4개 시나리오 exit 0 회귀 확인).
set -euo pipefail

# git diff --cached 는 저장소 루트 기준 경로를 돌려주므로, 이 훅의 모든 파일 검사는
# cwd 가 저장소 루트임을 전제한다. git 은 훅을 항상 루트에서 실행하지만 사람이
# 하위 디렉토리에서 직접 호출하면 존재하는 파일을 "디스크에 없음"으로 오판한다
# (2026-07-26 확인). 전제를 코드로 고정한다.
cd "$(git rev-parse --show-toplevel)" || exit 1

# 새로 추가되거나 수정된 파일 목록 추출 (공백/특수문자 포함 파일명 안전 처리를 위해 NUL 구분 배열 사용)
STAGED_FILES=()
mapfile -d '' -t STAGED_FILES < <(git diff --cached --name-only -z --diff-filter=ACM)

if [ "${#STAGED_FILES[@]}" -gt 0 ]; then
  # [보안 패치] 디스크 삭제 후 스테이징 메모리 잔류 취약점 방어
  # trufflehog 가용 여부와 무관하게 항상 수행한다: 시크릿이 담긴 파일을 git add 후
  # 디스크에서만 지우고(git rm --cached 안 함) trufflehog가 마침 없거나 실행 불가능한
  # 상황이면, 이 체크가 trufflehog 블록 안에만 있을 경우 통째로 건너뛰게 된다.
  # 디스크 기반 스캐너(trivy fs 등)는 지워진 파일의 내용을 볼 수 없으므로, 그 시크릿이
  # git 오브젝트에는 그대로 남은 채 아무 경고 없이 커밋될 수 있다.
  for FILE in "${STAGED_FILES[@]}"; do
    # -f는 일반 파일만 인정하므로 서브모듈(디렉터리로 스테이징됨)을 "삭제됨"으로 오탐하고,
    # 타겟이 아직 없는(dangling) 정상 심볼릭 링크도 오탐한다. -e(디렉터리 포함 존재 여부)와
    # -L(심볼릭 링크 자체의 존재)을 함께 확인해야 진짜로 아무것도 없는 경우만 걸러진다.
    if [ ! -e "$FILE" ] && [ ! -L "$FILE" ]; then
      echo "❌ 보안 에러: '$FILE' 파일이 디스크에 존재하지 않지만 Git 스테이징 대기열에는 남아있습니다."
      echo "   (만약 시크릿 유출을 피하려고 디스크에서 파일을 지우셨다면,"
      echo "    반드시 'git rm --cached $FILE' 명령어로 Git 캐시에서도 완전히 지워야 합니다!)"
      exit 1
    fi
  done
fi

# command -v는 mise shim 파일의 존재만 확인할 뿐 실제 실행 가능 여부는 보장하지 않는다.
# 이 훅은 core.hooksPath로 전역 등록되어 $HOME 트리 밖(예: /tmp, 별도 마운트)의
# 저장소에서도 실행되는데, mise 설정이 해석되지 않는 위치에서는
# "mise ERROR No version is set" 오류가 나면서 아래 trufflehog 호출이 실패하고,
# 그 실패가 "시크릿 유출" 오탐으로 이어져 정상 커밋을 차단하는 문제가 있었다.
# 따라서 실제 호출(--version)로 실행 가능 여부까지 확인한다.
if command -v trufflehog &>/dev/null && trufflehog --version &>/dev/null; then
  if [ "${#STAGED_FILES[@]}" -gt 0 ]; then
    tmp_hog=$(mktemp)
    # 전체가 아닌 변경된 파일만 스캔 (엄청 빠름)
    if ! trufflehog filesystem "${STAGED_FILES[@]}" --no-update --fail >"$tmp_hog" 2>&1; then
      echo "🔒 커밋 전 시크릿 스캔 결과 (trufflehog):"
      cat "$tmp_hog"
      echo "❌ 시크릿 유출이 발견되어 커밋이 차단되었습니다."
      rm -f "$tmp_hog"
      exit 1
    fi
    echo "  -> [✓] trufflehog secret scan passed"
    rm -f "$tmp_hog"
  fi
else
  echo "⚠️ trufflehog를 찾을 수 없거나 현재 위치에서 실행할 수 없어 시크릿 스캔을 건너뜁니다."
fi

# [추가] 커밋 시점에만 인프라 및 코드 사전 검증(pre-flight-check)을 수행 (CWD 무관하게 상위 저장소 루트 기반 탐색)
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

# [추가] contexts/<skill>/{scripts,tests}/ 가 변경되면 해당 스킬의 회귀 테스트를 실행한다.
# 픽스처는 자동 실행될 때만 안전망이고, 수동 실행에 의존하면 문서일 뿐이다.
#
# references/ 변경은 트리거하지 않는다. 픽스처가 검증하는 대상은 룰북 문서가 아니라
# 검증기(스크립트)이므로 문서 편집만으로는 회귀가 생기지 않는다. 룰북을 자주 고치는
# 작업 흐름에서 매번 8초씩 기다리게 만들지 않기 위한 선택이다.
#
# 전체 스위트를 다 돌리면 28초라 매 커밋에 쓸 수 없다(2026-07-26 실측:
# aws/azure/openstack 각 8초대, containers 1.9초, k8s 1.0초, drawio-gen 0.08초).
# 다만 pre-flight-check/scripts/ 는 모든 스킬의 회귀 테스트가 검증하는 공통 대상이므로
# 이때만 전부 실행한다. 의존 스킬 목록을 여기에 하드코딩하면 스킬이 늘 때마다 드리프트한다.
CHANGED_SKILLS=()
add_skill() {
  local s existing
  s=$1
  [ -x "$REPO_ROOT/contexts/$s/tests/run.sh" ] || return 0
  for existing in "${CHANGED_SKILLS[@]:-}"; do
    [ "$existing" = "$s" ] && return 0
  done
  CHANGED_SKILLS+=("$s")
}

for FILE in "${STAGED_FILES[@]:-}"; do
  case "$FILE" in
  contexts/pre-flight-check/tests/lib/*)
    # tf 픽스처 공용 라이브러리. 이 라이브러리를 source 하는 것은 아래 세 스킬의
    # 스위트뿐이므로, 일반 규칙에 맡겨 pre-flight-check 스위트만 돌리면 정작 이
    # 라이브러리를 쓰는 코드가 한 번도 실행되지 않는다.
    # (pre-flight-check 스킬에도 자체 스위트가 생겼지만 그쪽은 compact-runner 와
    #  scripts/lib/tool-probe.sh 를 검증할 뿐 tf 픽스처와 무관하다.)
    for LIB_SKILL in aws azure openstack; do
      add_skill "$LIB_SKILL"
    done
    ;;
  contexts/pre-flight-check/scripts/*)
    for DIR in "$REPO_ROOT"/contexts/*/tests/run.sh; do
      [ -e "$DIR" ] || continue
      SKILL=${DIR#"$REPO_ROOT"/contexts/}
      add_skill "${SKILL%%/*}"
    done
    ;;
  contexts/*/scripts/* | contexts/*/tests/*)
    SKILL=${FILE#contexts/}
    add_skill "${SKILL%%/*}"
    ;;
  setup.sh | contexts/base.hooks.json)
    # setup.sh 는 contexts/ 밖에 있어 위 경로 규칙에 걸리지 않는다. 그 멱등성 회귀
    # 테스트는 dotfiles 스킬이 갖고 있으므로 명시적으로 연결한다. base.hooks.json 은
    # setup.sh 의 jq 훅 병합이 그대로 읽어 들이는 입력이라 같은 스위트로 검증한다.
    add_skill dotfiles
    ;;
  esac
done

# AI 토큰 최적화를 위해 compact-runner.sh가 존재하면 래퍼로 사용한다.
COMPACT_RUNNER="$HOME/dotfiles/contexts/pre-flight-check/scripts/compact-runner.sh"
if [ ! -x "$COMPACT_RUNNER" ]; then
  COMPACT_RUNNER="bash"
fi

if [ "${#CHANGED_SKILLS[@]}" -gt 0 ]; then
  echo "🧪 변경된 스킬의 회귀 테스트를 실행합니다: ${CHANGED_SKILLS[*]}"
  for SKILL in "${CHANGED_SKILLS[@]}"; do
    if ! "$COMPACT_RUNNER" "$REPO_ROOT/contexts/$SKILL/tests/run.sh"; then
      echo "❌ $SKILL 회귀 테스트 실패로 커밋이 차단되었습니다."
      echo "   재현: bash $REPO_ROOT/contexts/$SKILL/tests/run.sh"
      exit 1
    fi
  done
fi

# [추가] contexts/ 하위 룰북(.md)이 변경되면 프롬프트 코퍼스 린트를 실행한다.
# 지금까지 prompt-lint.sh 실행은 CLAUDE.md 조항에 적힌 에이전트 규율에만 의존했고
# 기계적 강제가 없어, 사람이 직접 .md 를 고치면 SSOT 목록 불일치·깨진 참조 링크가
# 검증 없이 커밋될 수 있었다. 이 훅은 전역 등록이라 무관한 저장소에서도 실행되므로,
# 해당 저장소 안에 린터가 실재할 때만 동작시킨다(dotfiles 저장소에서만 참).
PROMPT_LINT="$REPO_ROOT/contexts/dotfiles/scripts/prompt-lint.sh"
if [ -f "$PROMPT_LINT" ]; then
  for FILE in "${STAGED_FILES[@]:-}"; do
    case "$FILE" in
    contexts/*.md)
      echo "📝 룰북(.md) 변경이 감지되어 프롬프트 코퍼스 린트를 실행합니다..."
      if ! "$COMPACT_RUNNER" "$PROMPT_LINT"; then
        echo "❌ 프롬프트 코퍼스 린트 실패로 커밋이 차단되었습니다."
        echo "   재현: bash $PROMPT_LINT"
        exit 1
      fi
      break
      ;;
    esac
  done
fi

# [추가] agent-handoff 프롬프트 원본이 변경되면 배포본 드리프트를 자가 치유한다.
# 이 스킬만 심볼릭 링크가 아니라 복사본으로 배포된다(나머지 11건은 링크라 원본이 곧
# 배포본이며 드리프트가 구조적으로 불가능하다). 원본을 고치고 재배포하지 않으면 양측
# 에이전트가 구버전 조항으로 동작한다(2026-07-27 실측). 조항으로만 막혀 있던 것을
# 커밋 시점에 기계적으로 보장한다. $REPO_ROOT 기준이라 dotfiles 저장소에서만 동작한다.
HANDOFF_DEPLOY="$REPO_ROOT/contexts/agent-handoff/scripts/deploy.sh"
if [ -f "$HANDOFF_DEPLOY" ]; then
  for FILE in "${STAGED_FILES[@]:-}"; do
    case "$FILE" in
    contexts/agent-handoff/SKILL.md | contexts/agent-handoff/role.*.md)
      if ! bash "$HANDOFF_DEPLOY" --check; then
        echo "🔗 agent-handoff 배포본을 원본에 맞춰 재배포합니다..."
        bash "$HANDOFF_DEPLOY" || {
          echo "❌ agent-handoff 재배포 실패로 커밋이 차단되었습니다."
          exit 1
        }
      fi
      break
      ;;
    esac
  done
fi

# [추가] agent-handoff 프로토콜의 구조적 상태를 검사한다.
# 트리거 미해제(통신 파일 동시 존재)와 3왕복 상한 초과는 지금까지 SKILL.md 조항 문장에만
# 의존했고, 그 결과 아키텍트가 성실히 확인하지 않으면 그대로 통과했다(2026-07-28 실측:
# 왕복마다 새 task-id 가 발급되어 상한이 한 번도 발동하지 않음). 커밋 시점에 기계 판정한다.
# 이 훅은 전역 등록이라 무관한 저장소에서도 실행되므로, 검증기는 핸드오프 산출물이 없으면
# 아무 출력 없이 통과한다.
HANDOFF_CHECK="$REPO_ROOT/contexts/agent-handoff/scripts/handoff-check.sh"
if [ ! -f "$HANDOFF_CHECK" ]; then
  HANDOFF_CHECK="$HOME/dotfiles/contexts/agent-handoff/scripts/handoff-check.sh"
fi
if [ -f "$HANDOFF_CHECK" ]; then
  # --commit-gate: 3왕복 상한 초과는 경고만 남긴다. 상한은 에이전트 루프를 멈추라는
  # 조건이지 커밋을 막으라는 조건이 아니며, 오히려 그 시점에는 지금까지의 작업을 커밋해
  # 두고 사용자에게 개입을 요청하는 것이 정상 흐름이다.
  if ! bash "$HANDOFF_CHECK" --commit-gate "$REPO_ROOT"; then
    echo "❌ 핸드오프 상태 검사 실패로 커밋이 차단되었습니다."
    echo "   재현: bash $HANDOFF_CHECK --commit-gate $REPO_ROOT"
    exit 1
  fi
fi

# 검증 대상 판정. 예전에는 "저장소 루트에 pre-flight-check.sh 링크가 있는가"를 옵트인
# 마커로 삼고 ~/workspace 하위에만 링크를 자동 생성했다. 그 방식은 링크 자체가 게이트라서,
# workspace 밖의 상시 검증 대상(dotfiles 자신)이 수동으로 만든 링크에 의존했고 링크가
# 없으면 아무 경고 없이 검증이 통째로 빠졌다. 정본을 절대 경로로 직접 호출하고, 어떤
# 저장소를 검증할지는 아래 조건으로만 선언한다(무관한 외부 저장소는 여전히 제외).
DOTFILES_PFC="$HOME/dotfiles/contexts/pre-flight-check/scripts/pre-flight-check.sh"
PFC_TARGET=""
if [[ "$REPO_ROOT/" == "$HOME/workspace/"* || "$REPO_ROOT" == "$HOME/dotfiles" ]]; then
  if [ -x "$DOTFILES_PFC" ]; then
    PFC_TARGET="$DOTFILES_PFC"
  else
    # 상시 대상인데 정본이 없으면 조용히 넘기지 않는다. 과거 실패의 재발 지점이다.
    echo "⚠️ 상시 검증 대상 저장소이지만 정본을 실행할 수 없어 사전 검증을 건너뜁니다: $DOTFILES_PFC"
  fi
elif [ -f "$REPO_ROOT/pre-flight-check.sh" ]; then
  # 상시 대상 밖의 저장소는 루트에 링크를 둔 경우에만 검증한다(기존 옵트인 방식 하위 호환).
  PFC_TARGET="$REPO_ROOT/pre-flight-check.sh"
fi

if [ -n "$PFC_TARGET" ]; then
  RUN_COST_CHECK=true "$COMPACT_RUNNER" "$PFC_TARGET" || {
    echo "❌ 사전 검증 실패로 커밋이 차단되었습니다."
    exit 1
  }
fi
