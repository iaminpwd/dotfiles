#!/usr/bin/env bash
# 020-shell-scripting-standard.md의 Hard Block 조건에 따라 strict mode 선언.
# 검증 게이트는 모두 `|| { ...; exit 1; }`로 안전하게 처리됨.
set -euo pipefail

# bash 4.4 이상이 필요함 (mapfile -d 옵션 사용).
# 구버전 bash 환경 방어 및 macOS 기본 bash(3.2) 실행 방지용 버전 체크.
# bootstrap.sh 와 동일하게 brew bash 로 재실행을 시도함.
BASH_VERSION_NUM=$((${BASH_VERSINFO[0]:-0} * 100 + ${BASH_VERSINFO[1]:-0}))
if [ "$BASH_VERSION_NUM" -lt 404 ]; then
  for BASH_CANDIDATE in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    # 버전 산술은 후보 bash 안에서 평가되어야 하므로 홑따옴표가 맞다.
    # shellcheck disable=SC2016
    if [ -x "$BASH_CANDIDATE" ] &&
      [ "$("$BASH_CANDIDATE" -c 'echo $((BASH_VERSINFO[0] * 100 + BASH_VERSINFO[1]))' 2>/dev/null || echo 0)" -ge 404 ]; then
      # ${1+"$@"} 를 쓰는 이유: bash 4.4 미만은 set -u 아래에서 인자가 0개일 때 "$@" 를
      # unbound variable 로 취급해 죽는다. 이 분기가 도는 곳이 정확히 그 bash 다.
      exec "$BASH_CANDIDATE" "$0" ${1+"$@"}
    fi
  done
  echo "❌ 커밋 훅 실행에 bash 4.4 이상이 필요합니다 (현재 ${BASH_VERSION:-알 수 없음})." >&2
  echo "   macOS 기본 bash 는 3.2 입니다. 'brew install bash' 후 다시 시도하십시오." >&2
  exit 1
fi

# git 훅은 저장소 루트를 기준으로 실행되도록 cwd 고정 (하위 디렉토리 실행 시 파일 오판 방지).
cd "$(git rev-parse --show-toplevel)" || exit 1

# 비대화형(Git GUI, CI/CD 등) 커밋 환경에서도 mise 도구(trufflehog 등)를 찾을 수 있도록 PATH 주입
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

# 새로 추가되거나 수정된 파일 목록 추출 (공백/특수문자 포함 파일명 안전 처리를 위해 NUL 구분 배열 사용)
STAGED_FILES=()
mapfile -d '' -t STAGED_FILES < <(git diff --cached --name-only -z --diff-filter=ACM)

if [ "${#STAGED_FILES[@]}" -gt 0 ]; then
  # [보안 패치] 디스크 삭제 후 스테이징 메모리 잔류 취약점 방어.
  # 파일을 디스크에서만 지우고 'git rm --cached'를 안 한 경우 시크릿 스캔이 누락될 수 있음.
  for FILE in "${STAGED_FILES[@]}"; do
    # 서브모듈 및 정상 심볼릭 링크 오탐 방지용 검사
    if [ ! -e "$FILE" ] && [ ! -L "$FILE" ]; then
      echo "❌ 보안 에러: '$FILE' 파일이 디스크에 존재하지 않지만 Git 스테이징 대기열에는 남아있습니다."
      echo "   (만약 시크릿 유출을 피하려고 디스크에서 파일을 지우셨다면,"
      echo "    반드시 'git rm --cached $FILE' 명령어로 Git 캐시에서도 완전히 지워야 합니다!)"
      exit 1
    fi
  done
fi

# 임시 파일 및 자원 정리용 전역 EXIT trap 헬퍼
TMP_HOG=""
cleanup() {
  [ -n "$TMP_HOG" ] && rm -f "$TMP_HOG" 2>/dev/null || true
}
trap cleanup EXIT

# mise 환경이 구성되지 않은 외부 저장소에서의 오탐 차단을 위해 실제 실행 가능 여부(--version) 점검.
if command -v trufflehog &>/dev/null && trufflehog --version &>/dev/null; then
  if [ "${#STAGED_FILES[@]}" -gt 0 ]; then
    TMP_HOG=$(mktemp)
    # 전체가 아닌 변경된 파일만 스캔 (엄청 빠름)
    if ! trufflehog filesystem "${STAGED_FILES[@]}" --no-update --fail >"$TMP_HOG" 2>&1; then
      echo "🔒 커밋 전 시크릿 스캔 결과 (trufflehog):"
      cat "$TMP_HOG"
      echo "❌ 시크릿 유출이 발견되어 커밋이 차단되었습니다."
      exit 1
    fi
    echo "  -> [✓] trufflehog secret scan passed"
  fi
else
  echo "⚠️ trufflehog를 찾을 수 없거나 현재 위치에서 실행할 수 없어 시크릿 스캔을 건너뜁니다."
fi

# 커밋 시점에만 인프라 및 코드 사전 검증(pre-flight-check)을 수행 (CWD 무관하게 상위 저장소 루트 기반 탐색)
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

# 변경된 스킬 폴더에 한정하여 회귀 테스트 실행.
# 성능 최적화를 위해 전체 테스트 대신 영향받는 스킬만 트리거 (공통 모듈 변경 시 전체 검증).
CHANGED_SKILLS=()
add_skill() {
  local s existing
  s=$1
  [ -x "$REPO_ROOT/contexts/$s/tests/run.sh" ] || return 0
  for existing in "${CHANGED_SKILLS[@]:-}"; do
    [ "$existing" = "$s" ] && return 0
  done
  CHANGED_SKILLS+=("$s")
}

for FILE in "${STAGED_FILES[@]:-}"; do
  case "$FILE" in
  contexts/pre-flight-check/tests/lib/*)
    # tf 픽스처 공용 라이브러리를 참조하는 주요 클라우드 스킬 테스트 트리거
    for LIB_SKILL in aws azure openstack; do
      add_skill "$LIB_SKILL"
    done
    ;;
  contexts/pre-flight-check/scripts/*)
    for DIR in "$REPO_ROOT"/contexts/*/tests/run.sh; do
      [ -e "$DIR" ] || continue
      SKILL=${DIR#"$REPO_ROOT"/contexts/}
      add_skill "${SKILL%%/*}"
    done
    ;;
  contexts/*/scripts/* | contexts/*/tests/*)
    SKILL=${FILE#contexts/}
    add_skill "${SKILL%%/*}"
    ;;
  bootstrap.sh | ansible/site.yml | bin/utils/merge-agent-hooks.sh | contexts/base.hooks.json)
    # bootstrap.sh 와 ansible 관련 셋업 변경 시 dotfiles 스킬 검증 묶어서 실행
    add_skill dotfiles
    ;;
  esac
done

# AI 토큰 최적화를 위해 compact-runner.sh가 존재하면 래퍼로 사용한다.
COMPACT_RUNNER="$REPO_ROOT/bin/hooks/compact-runner.sh"
if [ ! -x "$COMPACT_RUNNER" ]; then
  COMPACT_RUNNER="bash"
fi

if [ "${#CHANGED_SKILLS[@]}" -gt 0 ]; then
  echo "🧪 변경된 스킬의 회귀 테스트를 실행합니다: ${CHANGED_SKILLS[*]}"
  for SKILL in "${CHANGED_SKILLS[@]}"; do
    if ! "$COMPACT_RUNNER" "$REPO_ROOT/contexts/$SKILL/tests/run.sh"; then
      echo "❌ $SKILL 회귀 테스트 실패로 커밋이 차단되었습니다."
      echo "   재현: bash $REPO_ROOT/contexts/$SKILL/tests/run.sh"
      exit 1
    fi
  done
fi

# contexts/ 하위 룰북(.md) 변경 시 프롬프트 린트를 실행하여 참조 파손 방지.
PROMPT_LINT="$REPO_ROOT/bin/linters/prompt-lint.sh"
if [ -f "$PROMPT_LINT" ]; then
  for FILE in "${STAGED_FILES[@]:-}"; do
    case "$FILE" in
    contexts/*.md)
      echo "📝 룰북(.md) 변경이 감지되어 프롬프트 코퍼스 린트를 실행합니다..."
      if ! "$COMPACT_RUNNER" "$PROMPT_LINT"; then
        echo "❌ 프롬프트 코퍼스 린트 실패로 커밋이 차단되었습니다."
        echo "   재현: bash $PROMPT_LINT"
        exit 1
      fi
      break
      ;;
    esac
  done
fi

